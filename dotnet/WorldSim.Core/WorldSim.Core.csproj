<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Unity package's runtime sources as a plain library (netstandard2.1 = Unity's API level). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>WorldSim.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PackageRoot)Runtime/**/*.cs" />
  </ItemGroup>
</Project>
