<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Browser host: runs the same WorldSim.Core in WebAssembly; rendering and UI are in wwwroot (Three.js). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PackageRoot)Content/Resources/WorldSimContent/*.json" LogicalName="WorldSimContent.%(Filename).json" />
    <TrimmerRootAssembly Include="WorldSim.Web" />
    <TrimmerRootAssembly Include="WorldSim.Core" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WorldSim.Core/WorldSim.Core.csproj" />
  </ItemGroup>
</Project>
